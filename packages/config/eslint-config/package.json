{
    "name": "@sgx4u/eslint-config",
    "version": "0.0.0",
    "description": "ESLint flat config for @sgx4u packages, including runtime boundaries.",
    "license": "MIT",
    "author": "Subhajit Ghosh",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./index.d.ts",
                "default": "./index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test index.test.js",
        "check:package": "publint && attw --pack ."
    },
    "dependencies": {
        "@eslint/js": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-boundaries": "catalog:",
        "eslint-plugin-turbo": "catalog:",
        "globals": "catalog:",
        "typescript-eslint": "catalog:"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "eslint": "catalog:",
        "publint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "eslint": "^10.0.0",
        "typescript": ">=6"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
        "directory": "packages/config/eslint-config"
    },
    "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/develop/packages/config/eslint-config",
    "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
    "engines": {
        "node": ">=22.12"
    }
}
