{
    "name": "@sgx4u/tsdown-config",
    "private": true,
    "description": "tsdown preset for dual ESM and CJS @sgx4u libraries.",
    "type": "module",
    "exports": {
        ".": {
            "@sgx4u/source": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test src/define-library-config/define-library-config.test.ts"
    },
    "devDependencies": {
        "@sgx4u/eslint-config": "workspace:*",
        "@sgx4u/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "tsdown": "^0.23.0"
    }
}
