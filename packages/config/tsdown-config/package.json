{
    "name": "@sgx4u/tsdown-config",
    "version": "0.0.0",
    "description": "tsdown preset for dual ESM and CJS @sgx4u libraries.",
    "license": "MIT",
    "author": "Subhajit Ghosh",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "test": "node --test src/index.test.ts",
        "check:package": "publint && attw --pack ."
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@sgx4u/eslint-config": "workspace:*",
        "@sgx4u/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "publint": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "tsdown": "^0.23.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
        "directory": "packages/config/tsdown-config"
    },
    "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/develop/packages/config/tsdown-config",
    "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
    "engines": {
        "node": ">=22.12"
    }
}
