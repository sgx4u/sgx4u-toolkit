{
    "name": "@sgx4u/string",
    "version": "0.0.0",
    "description": "Grapheme-safe string helpers: case, width, validation, encoding, and formatting, with no runtime dependencies.",
    "license": "MIT",
    "author": "Subhajit Ghosh",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "@sgx4u/source": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./transliterate": {
            "@sgx4u/source": "./src/transliterate.ts",
            "import": {
                "types": "./dist/transliterate.d.ts",
                "default": "./dist/transliterate.js"
            },
            "require": {
                "types": "./dist/transliterate.d.cts",
                "default": "./dist/transliterate.cjs"
            }
        },
        "./html-entities": {
            "@sgx4u/source": "./src/html-entities.ts",
            "import": {
                "types": "./dist/html-entities.d.ts",
                "default": "./dist/html-entities.js"
            },
            "require": {
                "types": "./dist/html-entities.d.cts",
                "default": "./dist/html-entities.cjs"
            }
        },
        "./validators/locale": {
            "@sgx4u/source": "./src/validators/locale.ts",
            "import": {
                "types": "./dist/validators/locale.d.ts",
                "default": "./dist/validators/locale.js"
            },
            "require": {
                "types": "./dist/validators/locale.d.cts",
                "default": "./dist/validators/locale.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.md",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "size": "size-limit",
        "check:package": "publint && attw --pack . --profile node16 && size-limit"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@sgx4u/eslint-config": "workspace:*",
        "@sgx4u/tsconfig": "workspace:*",
        "@sgx4u/tsdown-config": "workspace:*",
        "@sgx4u/vitest-config": "workspace:*",
        "@size-limit/preset-small-lib": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "fast-check": "catalog:",
        "publint": "catalog:",
        "size-limit": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
        "directory": "packages/string"
    },
    "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/develop/packages/string",
    "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
    "engines": {
        "node": ">=22.12"
    },
    "size-limit": [
        {
            "name": "isBlank",
            "path": "dist/index.js",
            "import": "{ isBlank }",
            "limit": "1 kB"
        },
        {
            "name": "toCamelCase",
            "path": "dist/index.js",
            "import": "{ toCamelCase }",
            "limit": "2 kB"
        },
        {
            "name": "truncate",
            "path": "dist/index.js",
            "import": "{ truncate }",
            "limit": "2 kB"
        },
        {
            "name": "wrapText",
            "path": "dist/index.js",
            "import": "{ wrapText }",
            "limit": "2 kB"
        },
        {
            "name": "getDisplayWidth",
            "path": "dist/index.js",
            "import": "{ getDisplayWidth }",
            "limit": "2.5 kB"
        },
        {
            "name": "truncateToDisplayWidth",
            "path": "dist/index.js",
            "import": "{ truncateToDisplayWidth }",
            "limit": "2.5 kB"
        },
        {
            "name": "slugify",
            "path": "dist/index.js",
            "import": "{ slugify }",
            "limit": "2 kB"
        },
        {
            "name": "isEmail",
            "path": "dist/index.js",
            "import": "{ isEmail }",
            "limit": "1.5 kB"
        },
        {
            "name": "isURL",
            "path": "dist/index.js",
            "import": "{ isURL }",
            "limit": "1.5 kB"
        },
        {
            "name": "pluralize",
            "path": "dist/index.js",
            "import": "{ pluralize }",
            "limit": "2.5 kB"
        },
        {
            "name": "createString",
            "path": "dist/index.js",
            "import": "{ createString }",
            "limit": "24 kB"
        },
        {
            "name": "Root entry",
            "path": "dist/index.js",
            "limit": "28 kB"
        },
        {
            "name": "transliterate",
            "path": "dist/transliterate.js",
            "limit": "20 kB"
        },
        {
            "name": "html entities",
            "path": "dist/html-entities.js",
            "limit": "12.1 kB"
        },
        {
            "name": "locale validators",
            "path": "dist/validators/locale.js",
            "limit": "8 kB"
        }
    ]
}
