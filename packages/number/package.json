{
    "name": "@sgx4u/number",
    "version": "0.0.0",
    "description": "Checks, parses, rounds, formats, and compares numbers, with precise decimal arithmetic, statistics, random values, bases, and Roman numerals.",
    "license": "MIT",
    "author": "Subhajit Ghosh",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "@sgx4u/source": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./words/en": {
            "@sgx4u/source": "./src/words/en.ts",
            "import": {
                "types": "./dist/words/en.d.ts",
                "default": "./dist/words/en.js"
            },
            "require": {
                "types": "./dist/words/en.d.cts",
                "default": "./dist/words/en.cjs"
            }
        },
        "./words/en-IN": {
            "@sgx4u/source": "./src/words/en-IN.ts",
            "import": {
                "types": "./dist/words/en-IN.d.ts",
                "default": "./dist/words/en-IN.js"
            },
            "require": {
                "types": "./dist/words/en-IN.d.cts",
                "default": "./dist/words/en-IN.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.md",
        "README.md",
        "FUNCTIONS.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "size": "size-limit --config ./size-limit.config.js",
        "check:package": "publint && attw --pack . --profile node16 && size-limit --config ./size-limit.config.js"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@sgx4u/eslint-config": "workspace:*",
        "@sgx4u/tsconfig": "workspace:*",
        "@sgx4u/tsdown-config": "workspace:*",
        "@sgx4u/vitest-config": "workspace:*",
        "@size-limit/preset-small-lib": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "fast-check": "catalog:",
        "publint": "catalog:",
        "size-limit": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
        "directory": "packages/number"
    },
    "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/develop/packages/number",
    "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
    "engines": {
        "node": ">=22.12"
    }
}
