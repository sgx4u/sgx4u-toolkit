{
    "name": "@sgx4u/boolean",
    "version": "0.0.0",
    "description": "Parses, formats, and combines boolean values.",
    "license": "MIT",
    "author": "Subhajit Ghosh",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "@sgx4u/source": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/**/*.md",
        "README.md",
        "FUNCTIONS.md"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "check:package": "publint && attw --pack . && size-limit"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "catalog:",
        "@sgx4u/eslint-config": "workspace:*",
        "@sgx4u/tsconfig": "workspace:*",
        "@sgx4u/tsdown-config": "workspace:*",
        "@sgx4u/vitest-config": "workspace:*",
        "@size-limit/preset-small-lib": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint": "catalog:",
        "fast-check": "catalog:",
        "publint": "catalog:",
        "size-limit": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "size-limit": [
        {
            "name": "isBoolean",
            "path": "dist/index.js",
            "import": "{ isBoolean }",
            "limit": "0.5 kB",
            "brotli": true
        },
        {
            "name": "not",
            "path": "dist/index.js",
            "import": "{ not }",
            "limit": "0.5 kB",
            "brotli": true
        },
        {
            "name": "all",
            "path": "dist/index.js",
            "import": "{ all }",
            "limit": "0.5 kB",
            "brotli": true
        },
        {
            "name": "allPass",
            "path": "dist/index.js",
            "import": "{ allPass }",
            "limit": "0.5 kB",
            "brotli": true
        },
        {
            "name": "parseBoolean",
            "path": "dist/index.js",
            "import": "{ parseBoolean }",
            "limit": "2 kB",
            "brotli": true
        },
        {
            "name": "formatBoolean",
            "path": "dist/index.js",
            "import": "{ formatBoolean }",
            "limit": "1.5 kB",
            "brotli": true
        },
        {
            "name": "createBoolean",
            "path": "dist/index.js",
            "import": "{ createBoolean }",
            "limit": "4 kB",
            "brotli": true
        },
        {
            "name": "root",
            "path": "dist/index.js",
            "limit": "4 kB",
            "brotli": true
        }
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
        "directory": "packages/boolean"
    },
    "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/develop/packages/boolean",
    "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
    "engines": {
        "node": ">=22.12"
    }
}
