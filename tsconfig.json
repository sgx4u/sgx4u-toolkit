{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "customConditions": ["@sgx4u/source"],
        "forceConsistentCasingInFileNames": true,
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": ["node"]
    },
    "include": ["turbo/generators/**/*.ts", "scripts/**/*.ts"]
}
