{
  "name": "@sgx4u/{{packageName}}",
  "version": "0.0.0",
  "description": "TODO: one sentence describing @sgx4u/{{packageName}}.",
  "license": "MIT",
  "author": "Subhajit Ghosh",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@sgx4u/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "README.md"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@sgx4u/eslint-config": "workspace:*",
    "@sgx4u/tsconfig": "workspace:*",
    "@sgx4u/tsdown-config": "workspace:*",
    "@sgx4u/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"{{#if (eq runtimeName "node")}},
    "@types/node": "catalog:"{{/if}}{{#if (eq runtimeName "edge")}},
    "@cloudflare/workers-types": "catalog:"{{/if}}
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
    "directory": "domains/{{domainName}}/{{packageName}}"
  },
  "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/main/domains/{{domainName}}/{{packageName}}",
  "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
  "engines": {
    "node": ">=22.12"
  }
}
