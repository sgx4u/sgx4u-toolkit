/**
 * Returns the public name of this package.
 *
 * The result is the scoped name and nothing else. This stub exists so the
 * new package typechecks, tests, and packs. Replace it before the first
 * release.
 *
 * @example
 * packageIdentifier()
 */
export function packageIdentifier(): string {
    return "@sgx4u/{{packageName}}";
}
