/**
 * Returns the public name of this package.
 *
 * Call this when a caller needs the scoped name as a value, for example a
 * log line or a registry lookup. This stub keeps the new package
 * typechecking, tested, and packable. Replace the body before the first
 * release and keep this TSDoc shape: what the function does, when to call
 * it, each parameter, the default, the return value, and any thrown error.
 *
 * @returns The scoped name `@sgx4u/{{packageName}}`.
 * @remarks Document parameters with `@param` and `@defaultValue`, and
 * document thrown errors with `@throws`, when the replacement has them.
 * @example
 * packageIdentifier()
 */
export function packageIdentifier(): string {
    return "@sgx4u/{{packageName}}";
}
