{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "baseBranchPatterns": ["develop"],
    "labels": ["dependencies"],
    "minimumReleaseAge": "3 days",
    "automerge": false,
    "schedule": ["before 5am on Monday"],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 5am on Monday"]
    },
    "packageRules": [
        {
            "description": "GitHub Actions updates are opened by Dependabot, not Renovate.",
            "matchManagers": ["github-actions"],
            "enabled": false
        },
        {
            "description": "Open one pull request for every non-major update. Major updates stay on their own pull requests.",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "groupName": "non-major dependencies"
        }
    ]
}
