{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "agentGuidance": true,
  "remoteCache": {
    "signature": true
  },
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_REF_NAME",
    "CHANGESETS_OUTPUT",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_REMOTE_CACHE_SIGNATURE_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check:package": {
      "dependsOn": ["build"]
    }
  },
  "boundaries": {
    "tags": {
      "tier:foundation": {
        "dependencies": {
          "allow": ["tier:foundation", "tier:platform"]
        }
      },
      "tier:capability": {
        "dependencies": {
          "allow": ["tier:foundation", "tier:capability", "tier:platform"]
        }
      },
      "tier:adapter": {
        "dependencies": {
          "allow": [
            "tier:foundation",
            "tier:capability",
            "tier:adapter",
            "tier:platform"
          ]
        }
      },
      "tier:platform": {
        "dependencies": {
          "deny": [
            "tier:foundation",
            "tier:capability",
            "tier:adapter",
            "runtime:universal",
            "runtime:edge",
            "runtime:node",
            "runtime:web",
            "runtime:native"
          ]
        }
      },
      "runtime:universal": {
        "dependencies": {
          "allow": ["runtime:universal", "tier:platform"]
        }
      },
      "runtime:edge": {
        "dependencies": {
          "deny": ["runtime:node", "runtime:web", "runtime:native"]
        }
      },
      "runtime:web": {
        "dependencies": {
          "deny": ["runtime:node", "runtime:native"]
        }
      },
      "runtime:native": {
        "dependencies": {
          "deny": ["runtime:node", "runtime:web"]
        }
      },
      "runtime:node": {
        "dependencies": {
          "deny": ["runtime:web", "runtime:native"]
        }
      }
    }
  }
}
