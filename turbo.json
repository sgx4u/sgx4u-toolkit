{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "stream",
    "agentGuidance": true,
    "remoteCache": {
        "signature": true
    },
    "globalPassThroughEnv": [
        "CI",
        "GITHUB_REF_NAME",
        "CHANGESETS_OUTPUT",
        "CHANGESET_PACK_DIR",
        "TURBO_TOKEN",
        "TURBO_TEAM",
        "TURBO_REMOTE_CACHE_SIGNATURE_KEY"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "lint": {},
        "dev": {
            "cache": false,
            "persistent": true
        },
        "check:package": {
            "dependsOn": ["build"]
        }
    },
    "boundaries": {
        "tags": {
            "layout:config": {
                "dependencies": {
                    "deny": ["layout:package"]
                }
            },
            "layout:package": {
                "dependencies": {
                    "allow": ["layout:package", "layout:config"]
                }
            },
            "runtime:universal": {
                "dependencies": {
                    "allow": ["runtime:universal", "layout:config"]
                }
            },
            "runtime:edge": {
                "dependencies": {
                    "deny": ["runtime:node", "runtime:web", "runtime:native"]
                }
            },
            "runtime:web": {
                "dependencies": {
                    "deny": ["runtime:node", "runtime:native"]
                }
            },
            "runtime:native": {
                "dependencies": {
                    "deny": ["runtime:node", "runtime:web"]
                }
            },
            "runtime:node": {
                "dependencies": {
                    "deny": ["runtime:web", "runtime:native"]
                }
            }
        }
    }
}
