{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "stream",
    "agentGuidance": true,
    "remoteCache": {
        "signature": true
    },
    "globalPassThroughEnv": ["CI"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "lint": {},
        "dev": {
            "cache": false,
            "persistent": true
        },
        "check:package": {
            "dependsOn": ["build"]
        }
    },
    "boundaries": {
        "tags": {
            "layout:config": {
                "dependencies": {
                    "deny": ["layout:package"]
                }
            },
            "layout:package": {
                "dependencies": {
                    "allow": ["layout:package", "layout:config"]
                }
            },
            "runtime:universal": {
                "dependencies": {
                    "allow": ["runtime:universal", "layout:config"]
                }
            },
            "runtime:edge": {
                "dependencies": {
                    "allow": [
                        "runtime:universal",
                        "runtime:edge",
                        "layout:config"
                    ]
                }
            },
            "runtime:node": {
                "dependencies": {
                    "allow": [
                        "runtime:universal",
                        "runtime:edge",
                        "runtime:node",
                        "layout:config"
                    ]
                }
            }
        }
    }
}
