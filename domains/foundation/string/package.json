{
  "name": "@sgx4u/string",
  "version": "0.0.0",
  "description": "Small string helpers that run anywhere JavaScript runs.",
  "license": "MIT",
  "author": "Subhajit Ghosh",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@sgx4u/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@sgx4u/eslint-config": "workspace:*",
    "@sgx4u/tsconfig": "workspace:*",
    "@sgx4u/tsdown-config": "workspace:*",
    "@sgx4u/vitest-config": "workspace:*",
    "eslint": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgx4u/sgx4u-toolkit.git",
    "directory": "domains/foundation/string"
  },
  "homepage": "https://github.com/sgx4u/sgx4u-toolkit/tree/develop/domains/foundation/string",
  "bugs": "https://github.com/sgx4u/sgx4u-toolkit/issues",
  "engines": {
    "node": ">=22.12"
  }
}
